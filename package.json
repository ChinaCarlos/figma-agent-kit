{
  "name": "figma-agent-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source Figma plugin + MCP bridge for AI agents (Cursor, Claude Code, Codex, …)",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "sync:bridge": "node ./scripts/sync-bridge-config.mjs",
    "dev": "pnpm sync:bridge && pnpm --filter figma-agent-plugin dev",
    "build": "pnpm sync:bridge && pnpm --filter figma-agent-plugin build",
    "dev:mcp": "pnpm sync:bridge && pnpm --filter figma-agent-mcp dev",
    "build:mcp": "pnpm sync:bridge && pnpm --filter figma-agent-mcp build",
    "build:all": "pnpm sync:bridge && pnpm -r --filter figma-agent-plugin --filter figma-agent-mcp run build",
    "start:mcp": "pnpm --filter figma-agent-mcp start",
    "release:mcp": "pnpm --filter figma-agent-mcp release",
    "release:mcp:patch": "pnpm --filter figma-agent-mcp release:patch",
    "release:mcp:minor": "pnpm --filter figma-agent-mcp release:minor",
    "release:mcp:major": "pnpm --filter figma-agent-mcp release:major",
    "release:plugin": "pnpm --filter figma-agent-plugin release",
    "release:plugin:patch": "pnpm --filter figma-agent-plugin release:patch",
    "release:plugin:minor": "pnpm --filter figma-agent-plugin release:minor",
    "release:plugin:major": "pnpm --filter figma-agent-plugin release:major",
    "pack:plugin": "pnpm --filter figma-agent-plugin pack:release",
    "release:kit": "node ./scripts/release-kit.mjs",
    "release:kit:patch": "node ./scripts/release-kit.mjs patch",
    "release:kit:minor": "node ./scripts/release-kit.mjs minor",
    "release:kit:major": "node ./scripts/release-kit.mjs major",
    "dev:docs": "pnpm --filter figma-agent-kit-docs dev",
    "build:docs": "pnpm --filter figma-agent-kit-docs build",
    "preview:docs": "pnpm --filter figma-agent-kit-docs preview",
    "sync:docs": "pnpm --filter figma-agent-kit-docs sync"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChinaCarlos/figma-agent-kit.git"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude",
    "ai",
    "design"
  ]
}
