{
  "name": "figma-agent-mcp",
  "version": "0.1.0",
  "description": "MCP server bridging Cursor agents to a Figma plugin via WebSocket",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "figma-agent-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/sync-bridge-config.mjs",
    "build": "tsc",
    "predev": "node ../../scripts/sync-bridge-config.mjs",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run build",
    "version:patch": "node scripts/release.mjs patch --no-git",
    "version:minor": "node scripts/release.mjs minor --no-git",
    "version:major": "node scripts/release.mjs major --no-git",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "publish:npm": "npm publish --access public --registry https://registry.npmjs.org/"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "cursor",
    "agent"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ChinaCarlos/figma-agent-kit/tree/main/packages/figma-agent-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChinaCarlos/figma-agent-kit.git",
    "directory": "packages/figma-agent-mcp"
  },
  "bugs": {
    "url": "https://github.com/ChinaCarlos/figma-agent-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "msgpackr": "^2.0.5",
    "pngjs": "^7.0.0",
    "upng-js": "^2.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.2"
  }
}
