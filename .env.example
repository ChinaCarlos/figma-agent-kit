# Optional runtime override for the MCP process only.
# Default comes from /bridge.config.json (synced into MCP + plugin on build).
# If you change the port, update bridge.config.json and rebuild the plugin so
# ui.html + manifest networkAccess stay aligned — then set the same value here
# only if you need an env override without regenerating defaults.
# FIGMA_AGENT_MCP_PORT=1998
